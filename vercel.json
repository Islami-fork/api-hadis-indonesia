{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.ts"
    },
    {
      "src": "/books/(.*)",
      "dest": "/server.ts"
    },
    {
      "src": "/books",
      "dest": "/server.ts"
    },
    {
      "src": "/random",
      "dest": "/server.ts"
    },
    {
      "src": "/ping",
      "dest": "/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/server.ts"
    }
  ]
}
